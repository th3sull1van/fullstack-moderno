# Copie para .env e ajuste os valores.
# O PostgreSQL pode subir via Docker Compose (capítulo 17):
#   docker compose up -d db

# Conexão com o PostgreSQL (Prisma)
DATABASE_URL="postgresql://app:senha@localhost:5432/skillhub?schema=public"

# Segredo usado pelo Auth.js para assinar a sessão JWT.
# Gere um valor forte com: npx auth secret
# ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# URL base da aplicação (usada pelo Auth.js em produção)
AUTH_URL="http://localhost:3000"
