// Schema do SkillHub — marketplace de serviços (capítulo 15).
// Modelos: Usuario (profissionais e clientes), Servico (anúncios) e
// Pedido (contratação de um serviço por um cliente).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String    @id @default(cuid())
  nome      String
  email     String    @unique
  senhaHash String
  criadoEm  DateTime  @default(now())

  servicos Servico[] // anúncios criados por este usuário
  pedidos  Pedido[]  @relation("ClientePedidos") // pedidos feitos por este usuário
}

model Servico {
  id           String   @id @default(cuid())
  titulo       String
  descricao    String
  precoCentavos Int
  categoria    String
  criadoEm     DateTime @default(now())

  donoId  String
  dono    Usuario  @relation(fields: [donoId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([categoria])
  @@index([donoId])
}

model Pedido {
  id       String   @id @default(cuid())
  criadoEm DateTime @default(now())

  servicoId String
  servico   Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   Usuario  @relation("ClientePedidos", fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}
