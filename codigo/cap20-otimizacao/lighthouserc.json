{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/servicos",
        "http://localhost:3000/servicos/1"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "lcp": ["error", { "maxNumericValue": 2000 }],
        "inp": ["error", { "maxNumericValue": 200 }],
        "cls": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 150 }],
        "largest-contentful-paint-element": ["warn"],
        "resource-summary:script:total": [
          "error",
          { "maxNumericValue": 350000 }
        ],
        "resource-summary:image:total": ["error", { "maxNumericValue": 500000 }],
        "unused-javascript": ["warn", { "maxLength": 0.35 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
