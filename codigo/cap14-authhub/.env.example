# SQLite (dev/teste — não precisa de servidor)
DATABASE_URL="file:./dev.db"

# PostgreSQL (produção) — descomente e troque o provider no schema.prisma
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/authhub?schema=public"

# Segredo do JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-aleatorio-de-48-bytes"

# Cookies httpOnly/Secure
COOKIE_SECURE="false"
